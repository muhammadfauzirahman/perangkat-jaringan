# Kredensial PostgreSQL lokal (dipakai docker-compose.yml)
POSTGRES_USER=jarkita
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=jarkita
# Port host untuk container Postgres. 5432/5433 sering sudah dipakai
# instalasi lain, jadi default-nya 5434. Ganti kalau bentrok.
POSTGRES_PORT=5434

# Connection string yang dipakai aplikasi & drizzle-kit.
# Nilainya harus cocok dengan variabel di atas.
DATABASE_URL=postgresql://jarkita:ganti_password_ini@localhost:5434/jarkita
